<Window x:Class="TemperatureVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Temperature Analyzer" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#FFD4D4D4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FF252526"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="🌡️ Temperature Analyzer" FontSize="20" FontWeight="Bold" 
                       Foreground="#FF4EC9B0"/>
            <TextBlock x:Name="StatusText" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Button x:Name="BtnStoreDataset" Content="Store Dataset" Click="StoreDataset_Click"/>
            <Button x:Name="BtnRetrieveDataset" Content="Retrieve Dataset" Click="RetrieveDataset_Click"/>
            <Button x:Name="BtnVisualizeData" Content="Visualize Data" Click="VisualizeData_Click" 
                    Background="#FF4EC9B0" Foreground="Black"/>
            <Button x:Name="BtnAddSample" Content="Add Sample Data" Click="AddSampleData_Click"/>
        </StackPanel>

        <DataGrid x:Name="DataTable" Grid.Row="2" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time Point" Binding="{Binding TimePoint}" Width="*"/>
                <DataGridTextColumn Header="Value (°C)" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <lvc:CartesianChart x:Name="TemperatureChart" Grid.Row="3" Margin="10" Height="250"
                            Series="{Binding Series}" LegendLocation="Top">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Time Points" Labels="{Binding Labels}"/>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Temperature (°C)"/>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>
    </Grid>
</Window>